{
  "name": "@jsbarcode/generic-barcode",
  "version": "4.0.0-alpha.5",
  "description": "Generic mock barcode encoder for testing JsBarcode",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
