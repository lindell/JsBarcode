{
  "name": "jsbarcode",
  "version": "4.0.0-alpha.5",
  "description": "Customizable barcode generator with support for multiple barcode formats",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./jsbarcode.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./jsbarcode.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./jsbarcode.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@jsbarcode/core": "*",
    "@jsbarcode/renderer-canvas": "*",
    "@jsbarcode/renderer-svg": "*",
    "@jsbarcode/code128": "*",
    "@jsbarcode/code39": "*",
    "@jsbarcode/codabar": "*",
    "@jsbarcode/ean-upc": "*",
    "@jsbarcode/itf": "*",
    "@jsbarcode/msi": "*",
    "@jsbarcode/pharmacode": "*",
    "@jsbarcode/generic-barcode": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
